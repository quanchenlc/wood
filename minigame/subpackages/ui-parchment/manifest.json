 "design_space": "portrait 375x812 pt; landscape 812x375 pt; specs rendered @2x",
 "density_note": "scale = texels per pt. Top-level fields = the @2x file (scale 2). Draw size (pt) = px / scale = logical_size. 9-slice: source insets px = nine_slice_insets of the variant actually loaded; destination insets = nine_slice_insets_pt. Snap all dest rects to device pixels.",
 "variant_rule": "dpr>=2.5 -> variants.3x if present else 2x; otherwise 2x. panel_vellum has 2x only. paper_tile: @2x 512² / @3x 768², both = 256pt cell.",
 "nine_slice_convention": "[left, top, right, bottom]",
 "drawer_draw_note": "DO NOT 9-slice or cover the paper body. Fill drawer rect by TILING paper_tile at 1 texel = 1 device px (cell = 256pt; repeat from drawer origin, do not scale with drawer height). Clip by height during unroll. tear_edge: top = paperBottom - 16pt (its 14pt top fade must lie over paper), 9-slice L/R only (center stretch), fixed height 32pt. roll_paper on the revealed bottom edge. Landscape: paper from y=0, tear bottom = windowHeight - safeBottom - 36 (318pt on iPhone X), tag hangs below it.",
 "removed": [
  "drawer_vellum (was 200x140 9-slice — caused vertical seam + blur)",
  "btn_icon_style (unused; style entry is strip row only)"
 ],
